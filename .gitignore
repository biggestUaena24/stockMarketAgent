# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.pid
*.tsbuildinfo
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local secrets and environment files (commit only the empty template)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.secrets*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local databases and private financial imports
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/imports/
/statements/
/local-data/

# local server and generated deployment artifacts
/.dev-server.*.log
/.preview.*.log
/.openai/*.zip
/.openai/*.tar
/.openai/*.tar.gz
/.openai/*.tgz
