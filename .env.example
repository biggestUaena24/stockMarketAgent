# Copy this file to .env.local for local development.
# Leave secrets empty here. Configure production values through OpenAI Sites.

# Production owner and machine authentication
OWNER_EMAIL=
SCHEDULER_SECRET=
NEXT_PUBLIC_SITE_URL=

# Market data: use ALPHA_VANTAGE_API_KEY for trial mode or FMP_API_KEY for full mode
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Optional evidence explanations
OPENAI_API_KEY=

# Optional email notifications
RESEND_API_KEY=
NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

# Local convenience only. Development mode already supplies a local demo owner.
# Never set this to true in production.
ALLOW_LOCAL_DEMO=false
